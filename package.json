{
  "name": "movietracker-web",
  "private": true,
  "type": "module",
  "description": "MovieTracker web app — TypeScript sources in src/, compiled ES modules committed at js/ and served raw by GitHub Pages.",
  "scripts": {
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.sw.json",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "watch": "tsc -p tsconfig.app.json --watch",
    "serve": "python3 -m http.server 8124"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
